<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moss_black">

    <LinearLayout
        android:id="@+id/welcomePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/welcome_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="42dp"
        android:paddingEnd="24dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="MOSSY\nMAYHEM"
            android:textColor="@color/cream"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="LIVE"
            android:textColor="@color/moss_lime"
            android:textSize="34sp"
            android:textStyle="bold|italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/tagline"
            android:textColor="@color/moss_lime"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Live documentary commentary for everyday chaos"
            android:textColor="@color/muted_cream"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="CHOOSE COMEDY MODE"
            android:textColor="@color/cream"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/funnyModeButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="FUNNY"
                android:textColor="@color/moss_black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/moss_lime"
                app:cornerRadius="18dp"
                app:strokeColor="@color/moss_lime"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unhingedModeButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="UNHINGED 18+"
                android:textColor="@color/cream"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/control_surface"
                app:cornerRadius="18dp"
                app:strokeColor="@color/record_red"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/modeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Cheeky documentary comedy • mild language"
            android:textColor="@color/muted_cream"
            android:textSize="11sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="START DOCUMENTARY"
            android:textColor="@color/moss_black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/moss_lime"
            app:cornerRadius="24dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/moss_black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Record • Pause Mossy • Share"
            android:textColor="@color/cream"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Secure backend • no API key on this phone"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cameraPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fillCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/top_title_background"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="MOSSY MAYHEM  LIVE"
                android:textColor="@color/cream"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/status_pill_background"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Connecting Mossy brain…"
                    android:textColor="@color/cream"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/modeBadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/status_pill_background"
                    android:gravity="center"
                    android:minWidth="82dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="FUNNY"
                    android:textColor="@color/moss_lime"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/commentaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/commentary_background"
                android:gravity="center_vertical"
                android:minHeight="88dp"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:text="Mossy is joining the walk…"
                android:textColor="@color/cream"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/control_panel_background"
                android:orientation="vertical"
                android:padding="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recordButton"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:text="@string/record"
                        android:textColor="@color/cream"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/control_surface"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/record_red"
                        app:strokeWidth="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/flipButton"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:text="@string/flip"
                        android:textColor="@color/cream"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/control_surface"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/moss_lime"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/muteButton"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:text="@string/mute"
                        android:textColor="@color/cream"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/control_surface"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/moss_lime"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shareButton"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/share"
                        android:textColor="@color/cream"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/control_surface"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/moss_lime"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pauseButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:text="PAUSE MOSSY"
                    android:textColor="@color/moss_black"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/moss_lime"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/moss_lime"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
