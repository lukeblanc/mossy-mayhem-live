<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moss_black">

    <LinearLayout
        android:id="@+id/welcomePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/welcome_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="42dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="MOSSY\nMAYHEM"
            android:textColor="@color/cream"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textColor="@color/moss_lime"
            android:textSize="31sp"
            android:textStyle="bold|italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tagline"
            android:textColor="@color/moss_lime"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="PICK YOUR MOSSY"
            android:textColor="@color/cream"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/funnyModeButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="FUNNY"
                android:textColor="@color/moss_black"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/moss_lime"
                app:cornerRadius="18dp"
                app:strokeColor="@color/moss_lime"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unhingedModeButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="UNHINGED 18+"
                android:textColor="@color/cream"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/control_surface"
                app:cornerRadius="18dp"
                app:strokeColor="@color/record_red"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/modeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Cheeky documentary comedy • smart scene watching"
            android:textColor="@color/muted_cream"
            android:textSize="11sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="SMART COST • Mossy watches locally and wakes the AI for key moments"
            android:textColor="@color/muted_cream"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="START"
            android:textColor="@color/moss_black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="@color/moss_lime"
            app:cornerRadius="24dp"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/moss_black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Point. Watch. Laugh."
            android:textColor="@color/cream"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cameraPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fillCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/status_pill_background"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Starting Mossy…"
                    android:textColor="@color/cream"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/modeBadgeText"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/status_pill_background"
                    android:gravity="center"
                    android:minWidth="68dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="FUNNY"
                    android:textColor="@color/moss_lime"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/smartStatsText"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="end"
                android:layout_marginTop="5dp"
                android:background="@drawable/status_pill_background"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="E 0 • F 0 • C 0 • US$0.000"
                android:textColor="@color/moss_lime"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kept only for binding compatibility during development; intentionally not shown. -->
        <TextView
            android:id="@+id/commentaryText"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/control_panel_background"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recordButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="@string/record"
                        android:textColor="@color/cream"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/control_surface"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/record_red"
                        app:strokeWidth="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/flipButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="@string/flip"
                        android:textColor="@color/cream"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/control_surface"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/moss_lime"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/muteButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="@string/mute"
                        android:textColor="@color/cream"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/control_surface"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/moss_lime"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shareButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/share"
                        android:textColor="@color/cream"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/control_surface"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/moss_lime"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pauseButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_margin="3dp"
                        android:layout_weight="2"
                        android:text="PAUSE MOSSY"
                        android:textColor="@color/moss_black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/moss_lime"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/moss_lime"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
